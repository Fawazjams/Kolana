# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as documentation.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kolana
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
INSIGHTFACE_MODEL=buffalo_l
PORT=8000

# JWT auth (see backend/jwt_auth.py). Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
AUTH_REQUIRED=false
